<?xml version="1.0" encoding="utf-8"?>
<!-- Behind icon-only tiles: a dark glass plate with a faint lit edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#14FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF2C2C30" android:endColor="#FF1C1C1F" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
