<?xml version="1.0" encoding="utf-8"?>
<!-- Top buttons: liquid-glass capsule; focused, it turns solid white like a tvOS button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFE9E9EE" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80FFFFFF" android:endColor="#14FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#12FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
        </layer-list>
    </item>
</selector>
